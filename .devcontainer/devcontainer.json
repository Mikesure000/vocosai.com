{
  "name": "VOCOS Full-stack",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    }
  },
  "remoteEnv": {
    "VOC_HOST": "0.0.0.0",
    "VOC_PORT": "8090"
  },
  "forwardPorts": [8090],
  "portsAttributes": {
    "8090": {
      "label": "VOCOS App",
      "onAutoForward": "openBrowser"
    }
  },
  "postCreateCommand": "python -m py_compile fullstack/app.py && node --check fullstack/public/app.js",
  "postStartCommand": "cd fullstack && nohup python app.py > /tmp/vocos.log 2>&1 &",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-vscode.vscode-typescript-next"
      ]
    }
  }
}
