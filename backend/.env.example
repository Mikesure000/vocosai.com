# Server
PORT=3000

# Database
VOCOS_DB_PATH=./data/vocos.sqlite

# Authentication — 必须设置强密钥，不能使用默认弱值
# 生成建议: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
VOCOS_JWT_SECRET=change-me-to-a-random-secret

# Model API Keys
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Model Mode: mock | live
VOCOS_MODEL_MODE=mock

# Python Export Microservice
EXPORT_SERVICE_URL=http://localhost:5001
