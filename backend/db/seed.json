          "format": "口播+展示型",
          "whenToUse": "新品上线、成分科普",
          "spec": "30-60秒，9:16竖屏，单人出镜"
        },
        {
          "format": "对比测评型",
          "whenToUse": "竞品分析、平替推荐",
          "spec": "45-90秒，多角度对比，数据可视化"
        }
