      "contentType": "美妆全品类",
      "bestPractice": [
        {
          "rule": "前3秒必须抛出冲突",
          "explanation": "抖音用户滑动速度极快，前3秒没有冲突/悬念就会划走",
          "example": "\"评论区炸了——都在说这个精华到底有没有用？\""
        },
        {
          "rule": "评论截图作开头钩子",
          "explanation": "用真实评论截图做视频封面/开头，比纯口播点击率高40%",
          "example": "截图展示\"贵在哪里\"\"真的有效吗\"等高频评论"
        },
        {
          "rule": "展示过程而非结论",
          "explanation": "抖音用户更相信\"看到的过程\"而非\"听到的结论\"",
          "example": "实拍使用前后对比+成分拆解过程"
        },
