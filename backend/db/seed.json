          "pattern": "医疗暗示",
          "reason": "美妆不能宣称治疗效果",
          "consequence": "平台处罚"
        },
        {
          "pattern": "微信/加V引流",
          "reason": "平台不允许站外引流",
          "consequence": "账号降权"
        }
      ],
      "recommendedFormats": [
